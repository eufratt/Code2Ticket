# Supabase Configuration (PostgreSQL Database access only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Blockchain Proof (Local Hardhat / Anvil RPC)
# Note: For Android emulator use http://10.0.2.2:8545, for iOS simulator use http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=http://10.0.2.2:8545
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Currency API
FRANKFURTER_BASE_URL=https://api.frankfurter.app

# LLM API (Free tier)
LLM_API_KEY=your-free-tier-llm-key
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta
