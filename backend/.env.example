# Salin ke .env lalu isi. JANGAN commit .env.
NODE_ENV=development
PORT=3000

# Koneksi Postgres langsung. Pakai role pemilik tabel (mis. postgres).
DATABASE_URL=postgres://postgres:password@localhost:5432/code2ticket
# disable | require (enkripsi tanpa verifikasi sertifikat) | verify-full
DATABASE_SSL=disable
DB_POOL_MAX=10

# Origin browser yang boleh memanggil API, pisahkan dengan koma. Kosong = tidak ada.
# (Aplikasi mobile native tidak mengirim Origin dan tidak terpengaruh.)
CORS_ORIGINS=

# Rahasia untuk POST /internal/tick (header X-Tick-Secret), minimal 16 karakter.
# Kosong = endpoint dimatikan.
TICK_SECRET=

# Scheduler node-cron di dalam proses ini (draw tiap menit, cleanup harian 20:00 UTC).
SCHEDULER_ENABLED=true

# Rate limit per IP per menit.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Set ke jumlah proxy di depan server (mis. 1) agar IP klien benar. 0 = tanpa proxy.
TRUST_PROXY=0
