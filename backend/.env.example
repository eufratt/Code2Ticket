# Salin ke .env lalu isi. JANGAN commit .env.
NODE_ENV=development
PORT=3000

# Koneksi Postgres langsung (postgres://USER:PASSWORD@HOST:PORT/DB). Pakai role pemilik tabel (mis. postgres).
DATABASE_URL=
# disable | require (enkripsi tanpa verifikasi sertifikat) | verify-full
DATABASE_SSL=disable
DB_POOL_MAX=10

# Origin browser yang boleh memanggil API, pisahkan dengan koma. Kosong = tidak ada.
# (Aplikasi mobile native tidak mengirim Origin dan tidak terpengaruh.)
CORS_ORIGINS=

# Rahasia untuk POST /internal/tick (header X-Tick-Secret), minimal 16 karakter.
# Kosong = endpoint dimatikan.
TICK_SECRET=

# Scheduler node-cron di dalam proses ini (draw tiap menit, cleanup harian 20:00 UTC).
SCHEDULER_ENABLED=true

# Rate limit per IP per menit.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Unggah foto profil (PUT /me/photo) per IP per menit.
UPLOAD_RATE_LIMIT_MAX=10

# Asisten AI (POST /chat). Kosongkan OPENAI_API_KEY/OPENAI_MODEL untuk mematikan fitur.
# Kunci hanya diisi di .env lokal / env Render; JANGAN commit.
OPENAI_API_KEY=
# Model wajib diatur (mis. nama model Chat Completions yang akunmu miliki). Tanpa default.
OPENAI_MODEL=
# Kuota pesan per pengguna per hari (zona Asia/Jakarta) dan per menit; dihitung di memori proses.
AI_DAILY_LIMIT_PER_USER=30
AI_DAILY_LIMIT_GLOBAL=300
AI_RATE_PER_MINUTE=8
OPENAI_TIMEOUT_MS=20000

# Jangkar hash blok ke blockchain testnet (lihat README "Jangkar blockchain"). Kosong / bukan "true" = mati.
# ANCHOR_PRIVATE_KEY dan ANCHOR_RPC_URL RAHASIA: isi hanya di .env lokal / env Render, JANGAN commit.
ANCHOR_ENABLED=
ANCHOR_RPC_URL=
ANCHOR_CHAIN_ID=
ANCHOR_PRIVATE_KEY=
ANCHOR_EXPLORER_TX_URL=
ANCHOR_PUBLIC_RPC_URL=

# Set ke jumlah proxy di depan server (mis. 1) agar IP klien benar. 0 = tanpa proxy.
TRUST_PROXY=0
